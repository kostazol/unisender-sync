{
  "Settings": {
    "Unisender": {
      "TagOwnershipMode": "Exclusive",
      "ConfirmOverwriteAllTags": true,
      "ConsentPolicy": "VerifiedByAdministrator"
    },
    "Sync": {
      "Enabled": true,
      "DryRun": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
